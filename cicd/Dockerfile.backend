# Backend image for Substrait. Built from the REPO ROOT, so COPY paths are
# repo-relative. Contract: EXPOSE 8000, serve GET /health, API under /api.
FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
# Wheels-only: this slim image has no C compiler, so a dep without a wheel
# fails fast and legibly instead of dying in a cryptic source build.
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt
COPY backend/ .
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
