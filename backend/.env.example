# Custom config. The platform pre-creates each entry under the app's Settings;
# set real values in the portal or with /substrait:env.
# Do NOT declare DATABASE_URL, JWT_SECRET or OBJECT_STORAGE_BUCKET — injected.

# Hiryu POS integration (PRD §9.2). Empty until the contract in §9.1 is agreed.
POS_WEBHOOK_URL=
POS_SHARED_SECRET=     # secret

# Suppress every outbound POS push. Start ON: the WMS runs in shadow mode
# during the pilot until stock-number ownership is settled (PRD §9.1).
POS_PUSH_ENABLED=false

# Local dev only. When SSO is off there is no X-Forwarded-Email header; with
# this set, requests resolve to DEV_USER_EMAIL instead of returning 401.
# MUST be false in any deployed environment.
ALLOW_ANONYMOUS_DEV=false
DEV_USER_EMAIL=dev@ninjavan.co

# Auto-provision (interim, until the admin screen in PRD M7 exists). An email
# the users table has never seen, arriving on this domain via the SSO header,
# is created as `staff` on the training site only — never on a live site, and
# never for a deactivated account. Empty disables it and restores the
# admin-adds-you-first behaviour.
AUTO_PROVISION_DOMAIN=ninjavan.co
